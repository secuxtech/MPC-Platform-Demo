# Database Configuration
DATABASE_URL="postgresql://mpcuser:mpcpass@localhost:5432/mpc_db?schema=public"

# API Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# MPC Configuration
DEFAULT_TENANT_ID=secux-tenant-001

# SoftHSM Configuration
SOFTHSM2_CONF=/etc/softhsm/softhsm2.conf
PKCS11_MODULE_PATH=/usr/lib/softhsm/libsofthsm2.so
HSM_TOKEN_LABEL=MPC-Token
HSM_USER_PIN=1234
HSM_SO_PIN=5678
