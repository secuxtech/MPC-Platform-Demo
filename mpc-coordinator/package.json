{
  "name": "mpc-coordinator",
  "version": "1.0.0",
  "description": "Node.js REST API coordinator for MPC threshold signatures (microservices architecture with SoftHSM)",
  "main": "dist/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test:rest": "tsx examples/rest-service-integration-test.ts",
    "example:bitcoin": "tsx examples/bitcoin-example.ts",
    "example:ethereum": "tsx examples/ethereum-example.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "hsm:init": "softhsm2-util --init-token --slot 0 --label MPC-Token --pin 1234 --so-pin 5678"
  },
  "keywords": [
    "mpc",
    "multi-party-computation",
    "threshold-signature",
    "ecdsa",
    "bitcoin",
    "ethereum"
  ],
  "author": "SecuX",
  "license": "GPL-3.0",
  "dependencies": {
    "@prisma/client": "^5.8.0",
    "axios": "^1.6.5",
    "dotenv": "^16.3.1",
    "ethers": "^6.10.0",
    "express": "^4.18.2",
    "graphene-pk11": "^2.3.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.30",
    "prisma": "^5.8.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
